# Copy to .env.local, then restart the dev server — Vite reads this only at
# startup. On Vercel these are baked in at build time, so changing them there
# needs a redeploy rather than just an edit.
#
# Both values are safe to publish. Vite inlines every VITE_ variable into the
# bundle served to the browser, which is exactly why DATABASE_URL must never
# appear here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Settings -> API Keys, the key marked "publishable". Older projects call this
# the "anon" key and it looks like eyJ... instead; either name is accepted.
# Never the secret or service_role key — that one bypasses every access rule.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
