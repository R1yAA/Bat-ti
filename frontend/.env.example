# Copy to .env.local. Vite inlines these into the browser bundle, so both
# values must be ones that are safe to publish — the anon key grants nothing on
# its own, and every private route is gated by the Go API verifying the signed
# token. The database password must never appear here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<the anon/publishable key>
