# ── Database ──────────────────────────────────────────────────────────────
# Local development (docker compose up -d)
DATABASE_URL=postgres://batti:batti_local_dev@localhost:5433/batti?sslmode=disable

# Supabase. Which pooler you want depends on how the process connects:
#
#   Session pooler, port 5432   — migrations and the scraper.
#                                 golang-migrate takes a session-level advisory
#                                 lock, which a transaction pooler breaks.
#   Transaction pooler, 6543    — the API on serverless.
#                                 Many short-lived invocations would exhaust
#                                 the direct connection limit.
#
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Authentication ────────────────────────────────────────────────────────
# The project URL. Its public JWKS is what tokens are verified against, so no
# JWT secret is needed here — verification uses the public half of the key
# only, and a leaked deployment still cannot mint tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Serves every request unauthenticated. Refused unless DATABASE_URL points at
# localhost, so it cannot be left on in front of real data.
# AUTH_DISABLED=true

# ── Frontend (frontend/.env.local) ────────────────────────────────────────
# Vite inlines every VITE_ variable into the bundle it ships to the browser.
# Only put public values here — never DATABASE_URL.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<the anon/publishable key>
